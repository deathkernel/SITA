# Copy this file to .env and add your Google AI Studio key.
# SITA loads .env automatically at startup. Never commit the real .env file.
GEMINI_API_KEY=replace-with-your-gemini-api-key

# Optional default model for all Gemini-backed specialists.
# Per-specialist model overrides belong in sita.toml under [gemini.models].
TARA_GEMINI_MODEL=gemini-3.8-flash
